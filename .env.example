NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=file:./dev.db
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY=replace-with-a-separate-at-least-32-character-key
BETTER_AUTH_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=hr-portal-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Use resend for normal production transactional email. Use graph only if
# Microsoft Entra credentials and an approved Microsoft 365 sender are available.
EMAIL_PROVIDER=console
# Use a sender address verified in the selected provider (for example, an address on tripleminds.co).
EMAIL_FROM=
# Create at https://resend.com/api-keys. Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Microsoft Graph / Entra ID configuration for Outlook/Microsoft 365 OTP delivery.
# EMAIL_PROVIDER=graph selects this provider. Keep it as console for local UI-only development.
# Directory (tenant) ID: Entra admin center > App registrations > your app > Overview.
MICROSOFT_TENANT_ID=
# Application (client) ID: the same app Overview page.
MICROSOFT_CLIENT_ID=
# Client secret VALUE: Entra > Certificates & secrets > Client secrets. Copy it immediately.
MICROSOFT_CLIENT_SECRET=
# Complete approved Microsoft 365 mailbox address used by Graph /users/{sender}/sendMail.
MICROSOFT_SENDER_EMAIL=
# Development-only option. Never enable OTP logging in production.
EMAIL_DEV_LOG_OTP=false
# Optional Google OAuth for already-provisioned HR accounts. Google sign-up is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
ADMIN_EMAIL=admin@tripleminds.co
ADMIN_ROLE_SLUG=admin
LOCAL_ADMIN_EMAIL=admin@tripleminds.co
LOCAL_ADMIN_PASSWORD=replace-with-a-local-only-password
LOCAL_ADMIN_NAME=Local HR Administrator
LOCAL_ADMIN_ORGANIZATION_NAME=Triple Minds
LOCAL_ADMIN_ORGANIZATION_SLUG=triple-minds
