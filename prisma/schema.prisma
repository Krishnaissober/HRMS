  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo        User         @relation("WorkflowTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  completedBy       User?        @relation("WorkflowTaskCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, assignedToUserId, status, dueAt])
  @@index([organizationId, sourceType, sourceId])
}

model WorkflowRule {
  id             String       @id @default(cuid())
  organizationId String
  eventType      String
  actions        Json
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, eventType])
}

model SalaryStructure {
  id              String       @id @default(cuid())
  organizationId  String
  employeeId      String       @unique
  currency        String
  basicSalary     Decimal
  components      Json
  active          Boolean      @default(true)
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy       User         @relation("SalaryStructureCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeId])
  @@index([organizationId, active])
}

model PayrollRun {
  id               String          @id @default(cuid())
  organizationId   String
  periodStart      DateTime
  periodEnd        DateTime
  status           String          @default("DRAFT")
  currency         String
  grossTotal       Decimal         @default(0)
  deductionTotal   Decimal         @default(0)
  netTotal         Decimal         @default(0)
  createdByUserId  String
  reviewedByUserId String?
  approvedByUserId String?
  reviewedAt       DateTime?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User            @relation("PayrollRunCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy       User?           @relation("PayrollRunReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedBy       User?           @relation("PayrollRunApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  results          PayrollResult[]

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, status, periodStart])
}

model PayrollResult {
  id                 String       @id @default(cuid())
  organizationId     String
  payrollRunId       String
  employeeId         String
  currency           String
  basicSalary        Decimal
  components         Json
  grossAmount        Decimal
  deductionAmount    Decimal
  netAmount          Decimal
  overtimeMinutes    Int          @default(0)
  payslipObjectKey   String?
  payslipFileName    String?
  payslipGeneratedAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRun         PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, payrollRunId, employeeId])
  @@unique([payslipObjectKey])
  @@index([organizationId, employeeId, createdAt])
}

model Expense {
  id                 String           @id @default(cuid())
  organizationId     String
  employeeId         String
  category           String
  amount             Decimal
  currency           String
  expenseDate        DateTime
  notes              String
  receiptObjectKey   String
  receiptFileName    String
  receiptContentType String
  receiptByteSize    Int
  approvalStatus     String           @default("PENDING")
  paymentStatus      String           @default("UNPAID")
  submittedByUserId  String
  decidedByUserId    String?
  paidByUserId       String?
  decisionReason     String?
  decidedAt          DateTime?
  paidAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  submittedBy        User             @relation("ExpenseSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  decidedBy          User?            @relation("ExpenseDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  paidBy             User?            @relation("ExpensePayer", fields: [paidByUserId], references: [id], onDelete: SetNull)
  history            ExpenseHistory[]

  @@unique([receiptObjectKey])
  @@index([organizationId, employeeId, createdAt])
  @@index([organizationId, approvalStatus, paymentStatus])
}

model ExpenseHistory {
  id             String       @id @default(cuid())
  organizationId String
  expenseId      String
  action         String
  fromStatus     String?
  toStatus       String?
  actorUserId    String
  reason         String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expense        Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, expenseId, createdAt])
}
