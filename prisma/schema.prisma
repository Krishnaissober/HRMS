generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                    @id
  name                           String
  email                          String                    @unique
  emailVerified                  Boolean                   @default(false)
  image                          String?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  accounts                       Account[]
  sessions                       Session[]
  memberships                    Membership[]
  auditLogs                      AuditLog[]                @relation("AuditActor")
  candidateActivities            CandidateActivity[]       @relation("CandidateActivityActor")
  createdInterviews              Interview[]               @relation("InterviewCreator")
  interviewCheckIns              Interview[]               @relation("InterviewCheckInActor")
  interviewCheckOuts             Interview[]               @relation("InterviewCheckOutActor")
  hostedCandidateVisits          CandidateVisit[]          @relation("CandidateVisitHost")
  candidateVisitCheckIns         CandidateVisit[]          @relation("CandidateVisitCheckInActor")
  candidateVisitCheckOuts        CandidateVisit[]          @relation("CandidateVisitCheckOutActor")
  interviewParticipants          InterviewParticipant[]
  interviewEvaluations           InterviewEvaluation[]
  interviewActivities            InterviewActivity[]       @relation("InterviewActivityActor")
  interviewAvailabilities        InterviewAvailability[]
  hiringDecisions                HiringDecision[]          @relation("HiringDecisionActor")
  offerTemplates                 OfferTemplate[]           @relation("OfferTemplateCreator")
  createdOffers                  Offer[]                   @relation("OfferCreator")
  offerApprovals                 OfferApproval[]           @relation("OfferApprovalActor")
  interviewTemplates             InterviewTemplate[]       @relation("InterviewTemplateCreator")
  employeeHistoryEvents          EmployeeHistory[]         @relation("EmployeeHistoryActor")
  assignedOnboardingTasks        OnboardingTask[]          @relation("OnboardingTaskAssignee")
  completedOnboardingTasks       OnboardingTask[]          @relation("OnboardingTaskCompleter")
  verifiedOnboardingDocs         OnboardingDocument[]      @relation("OnboardingDocumentVerifier")
  onboardingTemplatesCreated     OnboardingTemplate[]      @relation("OnboardingTemplateCreator")
  createdShifts                  Shift[]                   @relation("ShiftCreator")
  assignedEmployeeShifts         EmployeeShiftAssignment[] @relation("ShiftAssignmentActor")
  createdHolidays                Holiday[]                 @relation("HolidayCreator")
  attendanceHistoryEvents        AttendanceHistory[]       @relation("AttendanceHistoryActor")
  attendanceCorrectionsRequested AttendanceCorrection[]    @relation("CorrectionRequester")
  attendanceCorrectionsApproved  AttendanceCorrection[]    @relation("CorrectionApprover")
  leaveTypesCreated              LeaveType[]               @relation("LeaveTypeCreator")
  leaveBalanceTransactions       LeaveBalanceTransaction[] @relation("LeaveBalanceTransactionActor")
  leaveRequestsCreated           LeaveRequest[]            @relation("LeaveRequestCreator")
  leaveApprovals                 LeaveApproval[]           @relation("LeaveApprovalActor")
  leaveNotifications             LeaveNotification[]
  managedDocumentsCreated        ManagedDocument[]         @relation("ManagedDocumentCreator")
  documentVersionsCreated        DocumentVersion[]         @relation("DocumentVersionCreator")
  appNotifications               AppNotification[]
  reminders                      Reminder[]
  workflowTasksAssigned          WorkflowTask[]            @relation("WorkflowTaskAssignee")
  workflowTasksCompleted         WorkflowTask[]            @relation("WorkflowTaskCompleter")
  salaryStructuresCreated        SalaryStructure[]         @relation("SalaryStructureCreator")
  payrollRunsCreated             PayrollRun[]              @relation("PayrollRunCreator")
  payrollRunsReviewed            PayrollRun[]              @relation("PayrollRunReviewer")
  payrollRunsApproved            PayrollRun[]              @relation("PayrollRunApprover")
  expensesSubmitted              Expense[]                 @relation("ExpenseSubmitter")
  expensesDecided                Expense[]                 @relation("ExpenseDecider")
  expensesPaid                   Expense[]                 @relation("ExpensePayer")
  expenseHistoryEvents           ExpenseHistory[]
  exitCases                      ExitCase[]                @relation("ExitCaseInitiator")
  exitInterviews                 ExitInterview[]           @relation("ExitInterviewAuthor")
  exitSettlements                ExitSettlement[]          @relation("ExitSettlementActor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
}

model Organization {
  id                       String                     @id @default(cuid())
  name                     String
  slug                     String                     @unique
  status                   String                     @default("ACTIVE")
  timezone                 String                     @default("UTC")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  memberships              Membership[]
  roles                    Role[]
  auditLogs                AuditLog[]
  candidates               Candidate[]
  submissions              CandidateSubmission[]
  documents                CandidateDocument[]
  activities               CandidateActivity[]
  requisitions             JobRequisition[]
  applications             Application[]
  visits                   CandidateVisit[]
  interviews               Interview[]
  interviewTemplates       InterviewTemplate[]
  interviewNotifications   InterviewNotification[]
  interviewParticipants    InterviewParticipant[]
  interviewEvaluations     InterviewEvaluation[]
  interviewActivities      InterviewActivity[]
  interviewAvailabilities  InterviewAvailability[]
  hiringDecisions          HiringDecision[]
  offerTemplates           OfferTemplate[]
  offers                   Offer[]
  offerApprovals           OfferApproval[]
  offerDeliveries          OfferDelivery[]
  employees                Employee[]
  employeeHistory          EmployeeHistory[]
  onboardingTemplates      OnboardingTemplate[]
  onboardingInstances      OnboardingInstance[]
  onboardingTasks          OnboardingTask[]
  onboardingDocuments      OnboardingDocument[]
  onboardingAssets         OnboardingAsset[]
  accessProvisioning       SystemAccessProvisioning[]
  candidateCompletionLinks CandidateCompletionLink[]
  mentorAssignments        MentorAssignment[]         @relation("OrganizationMentorAssignments")
  shifts                   Shift[]
  employeeShiftAssignments EmployeeShiftAssignment[]
  holidays                 Holiday[]
  attendanceRecords        AttendanceRecord[]
  attendanceHistories      AttendanceHistory[]
  attendanceCorrections    AttendanceCorrection[]
  leaveTypes               LeaveType[]
  leaveBalances            LeaveBalance[]
  leaveBalanceTransactions LeaveBalanceTransaction[]
  leaveRequests            LeaveRequest[]
  leaveApprovals           LeaveApproval[]
  leaveNotifications       LeaveNotification[]
  managedDocuments         ManagedDocument[]
  documentVersions         DocumentVersion[]
  appNotifications         AppNotification[]
  reminders                Reminder[]
  workflowTasks            WorkflowTask[]
  workflowRules            WorkflowRule[]
  salaryStructures         SalaryStructure[]
  payrollRuns              PayrollRun[]
  payrollResults           PayrollResult[]
  expenses                 Expense[]
  expenseHistory           ExpenseHistory[]
  exitCases                ExitCase[]
  exitClearanceTasks       ExitClearanceTask[]
  exitInterviews           ExitInterview[]
  exitSettlements          ExitSettlement[]
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  memberships    MembershipRole[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  requestId      String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  outcome        String        @default("SUCCESS")
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model Candidate {
  id                              String                    @id @default(cuid())
  organizationId                  String
  referenceNo                     String                    @unique
  firstName                       String
  lastName                        String
  email                           String
  phone                           String
  dateOfBirth                     String?
  gender                          String?
  addressLine1                    String?
  addressLine2                    String?
  city                            String?
  state                           String?
  country                         String?
  postalCode                      String?
  education                       String?
  tenthInstitution                String?
  tenthBoard                      String?
  tenthPassingYear                String?
  tenthScore                      String?
  twelfthInstitution              String?
  twelfthBoard                    String?
  twelfthPassingYear              String?
  twelfthScore                    String?
  collegeName                     String?
  collegeDegree                   String?
  collegePassingYear              String?
  collegeScore                    String?
  employmentHistory               String?
  currentCompany                  String?
  howFound                        String?
  otherSource                     String?
  referenceName                   String?
  reasonForJobChange              String?
  professionalReference           String?
  professionalReferenceName       String?
  professionalReferenceProfile    String?
  professionalReferenceExperience String?
  professionalReferenceContact    String?
  signatureName                   String?
  acknowledgementDate             String?
  skills                          String?
  expectedCompensation            String?
  ctc                             String?
  hikePercentage                  String?
  noticePeriod                    String?
  bankAccountName                 String?
  bankName                        String?
  bankBranchName                  String?
  bankAccountNumber               String?
  bankIfscCode                    String?
  bankAccountType                 String?
  aadhaarNumber                   String?
  panNumber                       String?
  roleOfInterest                  String
  experience                      String?
  source                          String
  declarationAccepted             Boolean                   @default(false)
  consentAccepted                 Boolean                   @default(false)
  status                          String                    @default("APPLIED")
  statusReason                    String?
  statusNotes                     String?
  hrInterviewScheduledBy          String?
  hrInterviewerName               String?
  hrCommunicationRating           String?
  hrTechnicalSkillsRating         String?
  hrOverallFit                    String?
  hrComments                      String?
  hrReviewedByUserId              String?
  hrReviewedAt                    DateTime?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  organization                    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions                     CandidateSubmission[]
  applications                    Application[]
  documents                       CandidateDocument[]
  activities                      CandidateActivity[]
  visits                          CandidateVisit[]
  interviews                      Interview[]
  hiringDecisions                 HiringDecision[]
  offers                          Offer[]
  employee                        Employee?
  completionLinks                 CandidateCompletionLink[]

  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, status])
  @@index([organizationId, source])
}

model CandidateCompletionLink {
  id              String       @id @default(cuid())
  organizationId  String
  candidateId     String
  tokenHash       String       @unique
  requestedFields Json
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate       Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([organizationId, candidateId, expiresAt])
}

model CandidateSubmission {
  id             String       @id @default(cuid())
  organizationId String
  candidateId    String
  applicationId  String?
  referenceNo    String       @unique
  source         String
  formVersion    String       @default("phase1-v1")
  submittedAt    DateTime     @default(now())
  formData       Json
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([organizationId, submittedAt])
  @@index([candidateId, submittedAt])
}

model JobRequisition {
  id             String        @id @default(cuid())
  organizationId String
  referenceNo    String        @unique
  title          String
  status         String        @default("PUBLISHED")
  approvedAt     DateTime?
  openedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications   Application[]

  @@index([organizationId, status])
}

model Application {
  id              String                @id @default(cuid())
  organizationId  String
  referenceNo     String                @unique
  candidateId     String
  requisitionId   String
  status          String                @default("APPLIED")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate       Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requisition     JobRequisition        @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  submissions     CandidateSubmission[]
  interviews      Interview[]
  hiringDecisions HiringDecision[]
  offers          Offer[]
  employee        Employee?

  @@unique([candidateId, requisitionId])
  @@index([organizationId, status])
  @@index([organizationId, requisitionId])
}

model CandidateDocument {
  id             String       @id @default(cuid())
  organizationId String
  candidateId    String
  kind           String
  objectKey      String       @unique
  fileName       String
  contentType    String
  byteSize       Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([organizationId, candidateId, createdAt])
}

model CandidateActivity {
  id             String       @id @default(cuid())
  organizationId String
  candidateId    String
  actorUserId    String?
  action         String
  fromStatus     String?
  toStatus       String?
  note           String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  actor          User?        @relation("CandidateActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, candidateId, createdAt])
}

model CandidateVisit {
  id                    String       @id @default(cuid())
  organizationId        String
  candidateId           String
  interviewId           String?
  hostUserId            String?
  visitDate             DateTime
  purpose               String?
  status                String       @default("REGISTERED")
  checkedInAt           DateTime?
  checkedOutAt          DateTime?
  checkInActorUserId    String?
  checkOutActorUserId   String?
  lateArrivalMinutes    Int?
  earlyDepartureMinutes Int?
  durationMinutes       Int?
  exceptionType         String?
  exceptionNotes        String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate             Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interview             Interview?   @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  host                  User?        @relation("CandidateVisitHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  checkInActor          User?        @relation("CandidateVisitCheckInActor", fields: [checkInActorUserId], references: [id], onDelete: SetNull)
  checkOutActor         User?        @relation("CandidateVisitCheckOutActor", fields: [checkOutActorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, candidateId, visitDate])
  @@index([organizationId, status])
  @@index([organizationId, interviewId])
  @@index([organizationId, hostUserId, visitDate])
}

model InterviewTemplate {
  id              String                @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  status          String                @default("ACTIVE")
  questions       Json
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation("InterviewTemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  interviews      Interview[]
  evaluations     InterviewEvaluation[]

  @@index([organizationId, status])
}

model Interview {
  id                    String                  @id @default(cuid())
  organizationId        String
  referenceNo           String                  @unique
  candidateId           String
  applicationId         String
  templateId            String?
  round                 Int                     @default(1)
  scheduledStart        DateTime
  scheduledEnd          DateTime
  timezone              String
  mode                  String
  location              String?
  meetingLink           String?
  instructions          String?
  status                String                  @default("SCHEDULED")
  createdByUserId       String
  candidateCheckedInAt  DateTime?
  candidateCheckedOutAt DateTime?
  checkInActorUserId    String?
  checkOutActorUserId   String?
  noShowReason          String?
  noShowNotes           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate             Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application           Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  template              InterviewTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy             User                    @relation("InterviewCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  checkInActor          User?                   @relation("InterviewCheckInActor", fields: [checkInActorUserId], references: [id], onDelete: SetNull)
  checkOutActor         User?                   @relation("InterviewCheckOutActor", fields: [checkOutActorUserId], references: [id], onDelete: SetNull)
  participants          InterviewParticipant[]
  evaluations           InterviewEvaluation[]
  activities            InterviewActivity[]
  notifications         InterviewNotification[]
  candidateVisits       CandidateVisit[]

  @@index([organizationId, scheduledStart])
  @@index([organizationId, status])
  @@index([candidateId, scheduledStart])
  @@index([applicationId, round])
  @@index([organizationId, templateId])
}

model InterviewParticipant {
  id             String       @id @default(cuid())
  organizationId String
  interviewId    String
  userId         String
  role           String       @default("INTERVIEWER")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interview      Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([organizationId, userId])
}

model InterviewEvaluation {
  id             String             @id @default(cuid())
  organizationId String
  interviewId    String
  interviewerId  String
  templateId     String?
  scores         Json
  comments       String?
  recommendation String?
  status         String             @default("DRAFT")
  submittedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interview      Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer    User               @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  template       InterviewTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([interviewId, interviewerId])
  @@index([organizationId, interviewerId])
  @@index([organizationId, status])
}

model InterviewActivity {
  id             String       @id @default(cuid())
  organizationId String
  interviewId    String
  actorUserId    String?
  action         String
  note           String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interview      Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  actor          User?        @relation("InterviewActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, interviewId, createdAt])
}

model InterviewAvailability {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  startsAt       DateTime
  endsAt         DateTime
  timezone       String
  status         String       @default("AVAILABLE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, startsAt])
}

model InterviewNotification {
  id             String       @id @default(cuid())
  organizationId String
  interviewId    String
  type           String
  recipient      String
  status         String       @default("PENDING")
  scheduledFor   DateTime
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interview      Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, type, recipient])
  @@index([organizationId, scheduledFor, status])
}

model HiringDecision {
  id             String       @id @default(cuid())
  organizationId String
  candidateId    String
  applicationId  String
  decision       String
  reason         String?
  notes          String?
  actorUserId    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor          User         @relation("HiringDecisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  offers         Offer[]

  @@index([organizationId, applicationId, createdAt])
  @@index([organizationId, candidateId, createdAt])
}

model OfferTemplate {
  id               String       @id @default(cuid())
  organizationId   String
  name             String
  body             String
  approvalRequired Boolean      @default(true)
  approvalSteps    Json?
  status           String       @default("ACTIVE")
  createdByUserId  String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User         @relation("OfferTemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  offers           Offer[]

  @@index([organizationId, status])
}

model Offer {
  id                  String          @id @default(cuid())
  organizationId      String
  candidateId         String
  applicationId       String
  hiringDecisionId    String
  templateId          String
  status              String          @default("DRAFT")
  compensationSummary String?
  issueDate           DateTime?
  proposedStartDate   DateTime?
  expiryDate          DateTime?
  documentKey         String?
  responseTokenHash   String?         @unique
  sentAt              DateTime?
  viewedAt            DateTime?
  respondedAt         DateTime?
  responseNotes       String?
  createdByUserId     String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate           Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application         Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  hiringDecision      HiringDecision  @relation(fields: [hiringDecisionId], references: [id], onDelete: Restrict)
  template            OfferTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy           User            @relation("OfferCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvals           OfferApproval[]
  deliveries          OfferDelivery[]

  @@unique([hiringDecisionId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, applicationId])
  @@index([organizationId, candidateId])
}

model OfferApproval {
  id             String       @id @default(cuid())
  organizationId String
  offerId        String
